# =============================================================================
# AeroTrace NGEC 2026 — Production Environment Configuration Template
# =============================================================================
# Copy this file to .env and provide your production credentials.
# NOTE: .env is ignored by git to protect credentials from leakage.

# --- Database Configuration --------------------------------------------------
# Production: PostGIS container URL
# Testing/Local: SQLite in-memory (sqlite:///:memory:) or sqlite file
DATABASE_URL=postgresql+psycopg2://aq:aq@localhost:5432/aqdb
DB_ECHO=0

# --- Air Quality Ingestion Pipeline -----------------------------------------
# AQ_SOURCE: "live" (CPCB CAAQMS real-time adapter) | "mock" (offline test mode)
AQ_SOURCE=live
CPCB_API_BASE=https://app.cpcbccr.com/aqi_dashboard
CPCB_API_KEY=your_cpcb_api_key_here

# --- Meteorological Feed (Live Open-Meteo & IMD Fallback) ---------------------
# WEATHER_SOURCE: "live" (Open-Meteo real-time HTTP client) | "mock" (offline test mode)
WEATHER_SOURCE=live
OWM_API_KEY=your_openweathermap_api_key_here
OWM_API_TIMEOUT=10

# --- Historical Climatology & Secondary Provider (WAQI) ---------------------
WAQI_TOKEN=your_waqi_api_token_here
WAQI_API_KEY=your_waqi_api_token_here

# --- CORS (comma-separated allowed origins or wildcard for local demos) ------
CORS_ORIGINS=*

# --- Geographic & Station Defaults -------------------------------------------
TZ=Asia/Kolkata
CITY_CONFIG=city_config.yml
STATION_NAME=Shivajinagar
STATION_CITY=Pune
STATION_STATE=Maharashtra
STATION_NETWORK=CPCB_CAAQMS

# --- AI Intelligence & Enforcement Dispatch (Anish) ------------------------
GEMINI_API_KEY=your_gemini_api_key_here
ML_MODEL_URL=https://vocalize-oncoming-wolf.ngrok-free.dev

# --- Production Server Deployment --------------------------------------------
# Command: uvicorn app.api:app --host 0.0.0.0 --port 8000 --workers 1
PORT=8000
HOST=0.0.0.0
