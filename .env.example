# --- Database (PostGIS via docker-compose) ---
DATABASE_URL=postgresql+psycopg2://aq:aq@localhost:5432/aqdb

# --- Ingestion source ---
# "mock" (default, deterministic, offline) | "live" (real CPCB CAAQMS adapter)
AQ_SOURCE=mock
CPCB_API_BASE=https://app.cpcbccr.com/aqi_dashboard

# --- CORS (comma-separated allowed origins) ---
# Local dev default below. In production pin explicit origins, e.g.:
#   CORS_ORIGINS=https://aerotrace.example.gov,https://www.aerotrace.example.gov
# ('*' wildcard is allowed for local demos ONLY.)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- AI provider (optional; template fallback used when unset) ---
# GEMINI_API_KEY=your_gemini_api_key_here

# --- External data tokens (optional; feature degrades gracefully when unset) ---
# WAQI_TOKEN=your_waqi_token_here

# --- Target station defaults (used by seed) ---
TZ=Asia/Kolkata
